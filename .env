DEEPSEEK_API_KEY=sk-...
# DeepSeek is OpenAI-compatible. "deepseek-flash" is served by DeepSeek-V4.1-Flash.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
# "disabled" (default, faster, simplest tool loop) or "enabled" (reasoning_content is replayed automatically)
DB_PATH=data/app.db

